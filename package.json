{
  "name": "junk-detector",
  "version": "1.0.0",
  "description": "Deteksi file cache Node.js, npm, dan Python di sistem.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,yellow \"vite\" \"wait-on http://localhost:5173 && NODE_ENV=development electron .\"",
    "build": "vite build",
    "start": "electron .",
    "preview": "vite preview"
  },
  "bin": {
    "junk-detector": "./index.js"
  },
  "keywords": [
    "cache",
    "detector",
    "nodejs",
    "npm",
    "python",
    "junk"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.0",
    "electron": "^31.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^6.30.4"
  }
}
